{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo bench *)",
      "Bash(cargo fmt *)",
      "Bash(cargo run *)",
      "Bash(cargo fuzz *)",
      "Bash(cargo doc *)",
      "Bash(rustup *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(cargo publish *)",
      "Bash(rm -rf *)"
    ]
  }
}
